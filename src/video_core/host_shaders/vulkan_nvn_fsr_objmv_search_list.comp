// NVN Vulkan renderer, [Debug] nvn_fsr_bm_compact = 1: block matching pass 1b. One workgroup per entry of the block list
// written by vulkan_nvn_fsr_objmv_classify.comp (dispatched indirectly with its count), i.e. only the blocks that
// vulkan_nvn_fsr_objmv_search.comp would search. Steps 3-6 below are that shader's, unchanged; the camera vector is read
// the same way, and hold = 1 for low-rate (jump) blocks, 0 for silhouette blocks (what that shader computes for a searched
// block). Same bindings 0-8 / push constants as the classify pass. KEEP STEPS 3-6 IN STEP WITH vulkan_nvn_fsr_objmv_search.comp.

#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D col_cur;
layout(set = 0, binding = 1) uniform sampler2D col_prev;
layout(set = 0, binding = 2) uniform sampler2D mv_tex;
layout(set = 0, binding = 3) uniform sampler2D mask_tex;
layout(set = 0, binding = 4) uniform sampler2D sil_prev;
layout(set = 0, binding = 5) uniform sampler2D depth_tex;
layout(set = 0, binding = 6) uniform sampler2D blk_prev;
layout(set = 0, binding = 7) uniform writeonly image2D blk_out;
layout(set = 0, binding = 8, std430) readonly buffer BlockList {
    uint dispatch_x;
    uint dispatch_y;
    uint dispatch_z;
    uint pad0;
    uint list[];
} bl;

layout(push_constant) uniform PushConstants {
    uint flags;      // bit 0 mask bound, 1 history valid (col_prev, sil_prev), 2 blk_prev valid, 3 depth params valid
    float jd_x;      // previous picture shift - current picture shift (render px, +y down)
    float jd_y;
    float p22;       // projection terms: linear depth = p32 / (d + p22)
    float p32;
    float near_limit;
    float chg_thr;
    float pad;
} pc;

const int kR = 20;           // largest search radius (low-rate blocks)
const int kW = 12;           // match window (block + 2 px border)
const int kT = kW + 2 * (kR + 1); // previous tile edge: window + coarse radius + fine step
shared float s_cur[kW * kW];
shared float s_prev[kT * kT];
shared float s_sad[64];
shared int s_idx[64];
shared float s_fine[9];
shared float s_sub[4];

float Luma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

float Sad(ivec2 off) {
    // off: offset of the window in s_prev relative to the zero-offset position (kR + 1, kR + 1)
    float s = 0.0;
    const int bx = kR + 1 + off.x, by = kR + 1 + off.y;
    for (int y = 0; y < kW; ++y) {
        for (int x = 0; x < kW; ++x) {
            s += abs(s_cur[y * kW + x] - s_prev[(by + y) * kT + bx + x]);
        }
    }
    return s;
}

void main() {
    const ivec2 size = textureSize(col_cur, 0);
    const uint e = bl.list[gl_WorkGroupID.x];
    const ivec2 blk = ivec2(int(e & 0x7fffu), int((e >> 15) & 0x7fffu));
    const bool jump = (e & 0x80000000u) != 0u;
    const ivec2 o = blk * 8;
    const uint lid = gl_LocalInvocationIndex;
    // camera vector at the block centre (the search is centred on it)
    vec2 cmv = texelFetch(mv_tex, clamp(o + 4, ivec2(0), size - 1), 0).rg;
    if (any(isnan(cmv)) || any(isinf(cmv))) cmv = vec2(0.0);
    const ivec2 ci = ivec2(round(cmv));
    const float hold = jump ? 1.0 : 0.0;
    const int R = jump ? kR : 12;
    // 3. tiles: current window (block + 2 px), previous tile around the camera-reprojected window
    for (uint i = lid; i < uint(kW * kW); i += 64u) {
        const ivec2 t = clamp(o - 2 + ivec2(int(i) % kW, int(i) / kW), ivec2(0), size - 1);
        s_cur[i] = Luma(texelFetch(col_cur, t, 0).rgb);
    }
    const ivec2 po = o - 2 + ci - ivec2(kR + 1);
    for (uint i = lid; i < uint(kT * kT); i += 64u) {
        const ivec2 t = clamp(po + ivec2(int(i) % kT, int(i) / kT), ivec2(0), size - 1);
        s_prev[i] = Luma(texelFetch(col_prev, t, 0).rgb);
    }
    barrier();
    // 4. coarse search, step 2 over [-R, R]^2
    const int n1 = R + 1; // candidates per axis: -R, -R+2, ..., R
    const int nc = n1 * n1;
    float best = 1e30;
    int bi = 0;
    for (int i = int(lid); i < nc; i += 64) {
        const ivec2 off = ivec2(i % n1, i / n1) * 2 - R;
        float s = Sad(off);
        s += 1e-3 * float(abs(off.x) + abs(off.y)); // ties -> the smaller motion
        if (s < best) {
            best = s;
            bi = i;
        }
    }
    s_sad[lid] = best;
    s_idx[lid] = bi;
    barrier();
    if (lid == 0u) {
        for (int i = 1; i < 64; ++i) {
            if (s_sad[i] < s_sad[0]) {
                s_sad[0] = s_sad[i];
                s_idx[0] = s_idx[i];
            }
        }
    }
    barrier();
    const ivec2 coarse = ivec2(s_idx[0] % n1, s_idx[0] / n1) * 2 - R;
    // 5. fine: 3x3 around the coarse best
    if (lid < 9u) {
        const ivec2 off = coarse + ivec2(int(lid) % 3 - 1, int(lid) / 3 - 1);
        s_fine[lid] = Sad(clamp(off, ivec2(-kR - 1), ivec2(kR + 1)));
    }
    barrier();
    int fi = 4;
    for (int i = 0; i < 9; ++i) {
        if (s_fine[i] < s_fine[fi]) fi = i;
    }
    const ivec2 fbest = clamp(coarse + ivec2(fi % 3 - 1, fi / 3 - 1), ivec2(-kR), ivec2(kR));
    // 6. sub-pixel (parabola through the best and its 4 neighbours); camera candidate SAD; texture energy
    if (lid < 4u) {
        const ivec2 d4[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        s_sub[lid] = Sad(clamp(fbest + d4[lid], ivec2(-kR - 1), ivec2(kR + 1)));
    }
    barrier();
    if (lid != 0u) return;
    const float sb = Sad(fbest);
    const float s0 = Sad(ivec2(0));
    vec2 sub = vec2(0.0);
    {
        const float dx = s_sub[0] - 2.0 * sb + s_sub[1], dy = s_sub[2] - 2.0 * sb + s_sub[3];
        if (dx > 1e-4) sub.x = clamp(0.5 * (s_sub[0] - s_sub[1]) / dx, -0.5, 0.5);
        if (dy > 1e-4) sub.y = clamp(0.5 * (s_sub[2] - s_sub[3]) / dy, -0.5, 0.5);
    }
    float energy = 0.0;
    for (int y = 0; y < kW - 1; ++y) {
        for (int x = 0; x < kW - 1; ++x) {
            const float c = s_cur[y * kW + x];
            energy += abs(s_cur[y * kW + x + 1] - c) + abs(s_cur[(y + 1) * kW + x] - c);
        }
    }
    // confident: the best offset is not the camera vector, beats it by >= 40% (full weight at 60%) and by a clear
    // absolute margin (mean luma difference 0.01 .. 0.03 per window texel), on a textured window (flat windows match
    // anywhere)
    const float n = float(kW * kW);
    float conf = 0.0;
    if (fbest != ivec2(0) && s0 > 0.0) {
        conf = smoothstep(0.4, 0.6, 1.0 - sb / s0) * smoothstep(0.01 * n, 0.03 * n, s0 - sb) *
               smoothstep(0.02 * n, 0.06 * n, energy);
    }
    const vec2 disp = vec2(ci + fbest) + sub;      // matched picture displacement, cur -> prev
    const vec2 omv = disp - vec2(pc.jd_x, pc.jd_y); // minus the jitter change: surface motion
    imageStore(blk_out, blk, vec4(omv, conf, hold));
}
